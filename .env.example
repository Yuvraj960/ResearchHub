# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Flask
SECRET_KEY=your-very-secret-key-change-this
SECURITY_PASSWORD_SALT=your-password-salt-change-this
FLASK_ENV=development

# Database — SQLite (default for dev)
DATABASE_URL=sqlite:///researchhub.db

# Database — PostgreSQL (uncomment for production / Docker)
# DATABASE_URL=postgresql://researchhub:researchhub_password@localhost:5432/researchhub

# PostgreSQL credentials (Docker only)
POSTGRES_USER=researchhub
POSTGRES_PASSWORD=researchhub_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (SMTP) — fill in your Gmail App Password or SMTP server details
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173
